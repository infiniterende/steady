generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum Domain {
  HEALTH
  GROWTH
  FOCUS
  HOME
}

enum Priority {
  HIGH
  MEDIUM
  LOW
}

/// One row per Supabase auth user. `id` mirrors auth.users.id.
model Profile {
  id         String   @id @db.Uuid
  email      String   @unique
  name       String
  pointsGoal Int      @default(200)
  about      String?
  quietHours   Boolean @default(true)
  weeklyDigest Boolean @default(true)
  blockReminders Boolean @default(true) // heads-up before each timed block / event / task
  reminderLead   Int     @default(5)    // minutes before
  onboarded      Boolean @default(false) // finished (or skipped) the first-run setup
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  habits      Habit[]
  blocks      Block[]
  tasks       Task[]
  goals       Goal[]
  pointEvents PointEvent[]
  reminders   Reminder[]
  journal     JournalEntry[]
  events      CalendarEvent[]
  focus       FocusSession[]
  planner     PlannerItem[]
  plannerDays PlannerDay[]
}

/// A recurring routine with a default slot in the day.
model Habit {
  id          String   @id @default(cuid())
  userId      String   @db.Uuid
  name        String
  domain      Domain   @default(FOCUS)
  cadence     String   @default("Daily")
  time        String   @default("7:00 AM")
  minutes     Int      @default(20)
  note        String?
  progress    Int      @default(0) // 0-100, progress in the current cycle
  paused      Boolean  @default(false)
  archived    Boolean  @default(false)
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())

  // Flexible sizes: what "done" looks like on a low, normal and great day.
  minLabel     String? // e.g. "Read 1 page"
  stdLabel     String? // e.g. "Read 10 pages"
  stretchLabel String? // e.g. "Read 20 pages"
  minMinutes   Int     @default(2)
  stretchMinutes Int?

  user      Profile    @relation(fields: [userId], references: [id], onDelete: Cascade)
  blocks    Block[]
  reminders Reminder[]

  @@index([userId])
}

/// A concrete timed block on a specific day (generated from habits, or added ad hoc).
model Block {
  id        String   @id @default(cuid())
  userId    String   @db.Uuid
  habitId   String?
  date      DateTime @db.Date
  time      String
  minuteOfDay Int
  domain    Domain   @default(FOCUS)
  minutes   Int      @default(20)
  title     String
  note      String?
  done      Boolean  @default(false)
  size      HabitSize? // which version was done; null while open
  hidden    Boolean  @default(false)
  createdAt DateTime @default(now())

  user  Profile @relation(fields: [userId], references: [id], onDelete: Cascade)
  habit Habit?  @relation(fields: [habitId], references: [id], onDelete: SetNull)

  @@unique([habitId, date])
  @@index([userId, date])
}

enum HabitSize {
  MIN
  STANDARD
  STRETCH
}

/// A short goal for a given day ("Today's goals").
model Task {
  id        String   @id @default(cuid())
  userId    String   @db.Uuid
  date      DateTime @db.Date
  title     String
  category  Domain   @default(FOCUS)
  due       String   @default("Today")
  priority  Priority @default(MEDIUM)
  done      Boolean  @default(false)
  top       Boolean  @default(false) // one of the (max three) daily priorities
  firstStep String?  // the one small next action from "Help me start"
  createdAt DateTime @default(now())

  user  Profile         @relation(fields: [userId], references: [id], onDelete: Cascade)
  focus FocusSession[]

  @@index([userId, date])
}

/// A timed, bounded stretch of work, optionally started from a task.
model FocusSession {
  id         String   @id @default(cuid())
  userId     String   @db.Uuid
  taskId     String?
  date       DateTime @db.Date
  title      String
  plannedMin Int
  actualSec  Int      @default(0)
  completed  Boolean  @default(false) // ran to its stopping point
  createdAt  DateTime @default(now())

  user Profile @relation(fields: [userId], references: [id], onDelete: Cascade)
  task Task?   @relation(fields: [taskId], references: [id], onDelete: SetNull)

  @@index([userId, date])
}

enum GoalKind {
  COUNT   // accumulate toward a target (books read, sessions)
  MEASURE // track a measurement toward a target (weight, resting HR)
}

/// A longer-term target with daily entries and milestones.
model Goal {
  id        String   @id @default(cuid())
  userId    String   @db.Uuid
  name      String
  kind      GoalKind @default(COUNT)
  start     Float    @default(0) // MEASURE: the value you started from
  current   Float    @default(0) // COUNT: accumulated so far
  target    Float
  unit      String   @default("units")
  horizon   String   @default("No deadline")
  deadline  DateTime? @db.Date
  note      String   @default("Just started")
  step      Float    @default(1)
  createdAt DateTime @default(now())

  user       Profile     @relation(fields: [userId], references: [id], onDelete: Cascade)
  entries    GoalEntry[]
  milestones Milestone[]

  @@index([userId])
}

/// One logged value per goal per day (a weigh-in, or the running count).
model GoalEntry {
  id        String   @id @default(cuid())
  goalId    String
  date      DateTime @db.Date
  value     Float
  note      String?
  createdAt DateTime @default(now())

  goal Goal @relation(fields: [goalId], references: [id], onDelete: Cascade)

  @@unique([goalId, date])
}

/// A checkpoint on the way to a goal's target.
model Milestone {
  id        String   @id @default(cuid())
  goalId    String
  label     String
  value     Float
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())

  goal Goal @relation(fields: [goalId], references: [id], onDelete: Cascade)

  @@index([goalId])
}

/// Extra points not derived from blocks/tasks (timer starts, habit logs, sessions).
model PointEvent {
  id        String   @id @default(cuid())
  userId    String   @db.Uuid
  date      DateTime @db.Date
  amount    Int
  reason    String
  createdAt DateTime @default(now())

  user Profile @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, date])
}

enum Channel {
  PUSH
  EMAIL
}

/// A nudge for a habit at a time of day.
model Reminder {
  id          String   @id @default(cuid())
  userId      String   @db.Uuid
  habitId     String
  time        String
  minuteOfDay Int
  channel     Channel  @default(PUSH)
  repeat      String   @default("Every day")
  on          Boolean  @default(true)
  createdAt   DateTime @default(now())

  user  Profile @relation(fields: [userId], references: [id], onDelete: Cascade)
  habit Habit   @relation(fields: [habitId], references: [id], onDelete: Cascade)

  @@index([userId])
}

/// One journal entry per day: a mood and some writing.
model JournalEntry {
  id        String   @id @default(cuid())
  userId    String   @db.Uuid
  date      DateTime @db.Date
  mood      Int?     // 1 (sad) … 5 (great)
  title     String   @default("")
  body      String   @default("")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user   Profile        @relation(fields: [userId], references: [id], onDelete: Cascade)
  photos JournalPhoto[]

  @@unique([userId, date])
  @@index([userId, date])
}

/// A photo attached to a journal entry, stored in the private "journal" bucket.
model JournalPhoto {
  id        String   @id @default(cuid())
  entryId   String
  userId    String   @db.Uuid
  path      String   @unique // <userId>/<day>/<file> inside the bucket
  createdAt DateTime @default(now())

  entry JournalEntry @relation(fields: [entryId], references: [id], onDelete: Cascade)

  @@index([entryId])
}

enum CalendarKind {
  EVENT
  REMINDER
}

/// A one-off dated item on the calendar (tasks live in Task).
model CalendarEvent {
  id          String       @id @default(cuid())
  userId      String       @db.Uuid
  date        DateTime     @db.Date
  kind        CalendarKind @default(EVENT)
  title       String
  time        String?
  minuteOfDay Int?
  note        String?
  done        Boolean      @default(false)
  createdAt   DateTime     @default(now())

  user Profile @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, date])
}

enum PlannerKind {
  TASK
  ASSIGNMENT
  DEADLINE
  APPOINTMENT
  EVENT
  REMINDER
}

/// Something dated on the Planner: a task, assignment, deadline, appointment or event, with an optional reminder.
model PlannerItem {
  id          String      @id @default(cuid())
  userId      String      @db.Uuid
  date        DateTime    @db.Date
  kind        PlannerKind @default(TASK)
  title       String
  time        String?
  minuteOfDay Int?
  note        String?
  place       String? // shown as @place, e.g. where a reminder or appointment is
  priority    Priority    @default(MEDIUM)
  done        Boolean     @default(false)
  /// Minutes before the due moment to notify (0 = at the time). Null = no reminder.
  /// Untimed items are due at 9:00 AM for reminder purposes.
  remindMin   Int?
  createdAt   DateTime    @default(now())

  user Profile @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, date])
}

/// Per-day decoration on the Planner: a short label pill, a free-text note and a background tint.
model PlannerDay {
  id     String   @id @default(cuid())
  userId String   @db.Uuid
  date   DateTime @db.Date
  label  String?
  note   String?
  tint   String? // pink | butter | mint | sky

  user Profile @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, date])
}
